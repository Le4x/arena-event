# Simple API Environment Variables
# Copy this file to .env and customize values

# ============================================
# Database Configuration (Required)
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://arena:YOUR_PASSWORD@localhost:5432/arena_event

# ============================================
# Security (Optional - defaults provided)
# ============================================
# JWT secret for authentication (generate with: openssl rand -base64 64)
JWT_SECRET=arena-event-super-secret-jwt-key-2024

# JWT token expiration (default: 7 days)
JWT_EXPIRES_IN=7d

# ============================================
# CORS Configuration (Optional)
# ============================================
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# ============================================
# Media Upload Security (Optional)
# ============================================
# Token required for media uploads (leave empty to allow unauthenticated uploads)
SIMPLE_API_UPLOAD_TOKEN=

# ============================================
# API Configuration (Optional)
# ============================================
# Port for the API server (default: 3001)
PORT=3001

# Base URL for media URLs (defaults to request host)
API_BASE_URL=
