# ============================================
# Arena Event - Production Environment Variables
# ============================================
# Copy this file to .env.production and customize values

# ============================================
# Database Configuration
# ============================================
DB_USER=arena
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=arena_event
DATABASE_URL=postgresql://arena:CHANGE_ME_STRONG_PASSWORD@localhost:5432/arena_event?schema=public

# ============================================
# Security
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
JWT_EXPIRES_IN=7d

# Upload token for media files (generate with: openssl rand -hex 32)
SIMPLE_API_UPLOAD_TOKEN=CHANGE_ME_UPLOAD_TOKEN

# ============================================
# Redis Configuration (pour le scaling horizontal)
# ============================================
# Décommenter et configurer si vous utilisez Redis
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ============================================
# URLs Configuration
# Replace with your actual domain
# ============================================
DOMAIN=arena-event.fr

# API URLs (used by frontends to connect)
API_URL=https://api.arena-event.fr
API_BASE_URL=https://api.arena-event.fr
WS_URL=https://ws.arena-event.fr

# Frontend URLs (used for cross-app links)
ADMIN_URL=https://admin.arena-event.fr
PLAYER_URL=https://player.arena-event.fr
SCREEN_URL=https://screen.arena-event.fr
STUDIO_URL=https://studio.arena-event.fr

# ============================================
# CORS Configuration (sécurité)
# ============================================
# Liste des origines autorisées (séparées par des virgules)
CORS_ORIGINS=https://admin.arena-event.fr,https://player.arena-event.fr,https://screen.arena-event.fr,https://studio.arena-event.fr

# ============================================
# Server Configuration
# ============================================
NODE_ENV=production
PORT=3001

# ============================================
# SSL Configuration (Let's Encrypt)
# ============================================
LETSENCRYPT_EMAIL=admin@arena-event.fr
