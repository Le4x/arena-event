# ============================================
# Arena Event - Production Environment Variables
# ============================================
# Copy this file to .env.production and customize values

# ============================================
# Database Configuration
# ============================================
DB_USER=arena
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=arena_event

# ============================================
# Security
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET

# Upload token for media files (generate a strong token)
UPLOAD_TOKEN=CHANGE_ME_UPLOAD_TOKEN

# ============================================
# URLs Configuration
# Replace with your actual domain
# ============================================
DOMAIN=arena-event.fr

# API URLs (used by frontends to connect)
API_URL=https://api.arena-event.fr
WS_URL=https://ws.arena-event.fr

# Frontend URLs (used for cross-app links)
ADMIN_URL=https://admin.arena-event.fr
PLAYER_URL=https://player.arena-event.fr
SCREEN_URL=https://screen.arena-event.fr
STUDIO_URL=https://studio.arena-event.fr

# CORS origins (comma-separated list of allowed origins)
CORS_ORIGINS=https://admin.arena-event.fr,https://player.arena-event.fr,https://screen.arena-event.fr,https://studio.arena-event.fr

# ============================================
# SSL Configuration (Let's Encrypt)
# ============================================
LETSENCRYPT_EMAIL=admin@arena-event.fr
