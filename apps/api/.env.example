# Environment
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arena_event?schema=public"

# JWT
JWT_SECRET=change-this-to-a-very-secure-secret-minimum-32-characters

# CORS (Required in production - comma separated origins)
# Development: Automatically allows localhost on all ports
# Production: MUST set ALLOWED_ORIGINS or API will reject all requests
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://studio.yourdomain.com,https://play.yourdomain.com,https://screen.yourdomain.com

# Server
PORT=3001
