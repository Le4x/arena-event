# Arena Event - Environment Configuration
# Copy this file to .env and adjust values for your environment

# Domain Configuration
DOMAIN=arena-event.com

# API Configuration
API_URL=https://api.arena-event.com
API_PORT=3001

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/arena_event"

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiration
JWT_EXPIRES_IN=7d

# CORS Origins (comma-separated)
CORS_ORIGINS=https://arena-event.com,https://admin.arena-event.com,https://studio.arena-event.com,https://player.arena-event.com,https://screen.arena-event.com
